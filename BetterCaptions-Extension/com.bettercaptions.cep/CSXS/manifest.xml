<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest
  Version="7.0"
  ExtensionBundleId="com.bettercaptions.cep"
  ExtensionBundleVersion="0.1.0"
  ExtensionBundleName="Better Captions"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.bettercaptions.cep.panel" Version="0.1.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.bettercaptions.cep.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./host/index.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Better Captions</Menu>
          <Geometry>
            <Size>
              <Height>700</Height>
              <Width>420</Width>
            </Size>
            <MinSize>
              <Height>300</Height>
              <Width>260</Width>
            </MinSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/dark.png</Icon>
            <Icon Type="RollOver">./icons/dark.png</Icon>
            <Icon Type="DarkNormal">./icons/dark.png</Icon>
            <Icon Type="DarkRollOver">./icons/dark.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
